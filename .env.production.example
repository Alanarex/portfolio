# Copy to .env on the server (never commit the real file). Generate secrets with: openssl rand -base64 32
APP_NAME="Alaa Khalil"
APP_ENV=production
APP_DEBUG=false
# Generate once with: docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://example.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Used by Caddy for HTTPS (Let's Encrypt)
APP_DOMAIN=example.fr
ACME_EMAIL=you@example.fr

LOG_LEVEL=warning

DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=

REDIS_PASSWORD=

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
PROJECT_MEDIA_DISK=local

# Contact form delivery (SMTP of your mail provider)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Public GitHub activity on the home page (portfolio:sync-github, hourly)
GITHUB_USERNAME=Alanarex
# Optional: fine-grained token with no extra scope, only raises the API rate limit
GITHUB_TOKEN=
