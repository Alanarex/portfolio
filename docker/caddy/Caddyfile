# HTTPS is obtained and renewed automatically from Let's Encrypt for APP_DOMAIN.
{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy web:80
}

www.{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}
