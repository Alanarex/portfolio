# HTTPS is obtained and renewed automatically from Let's Encrypt for APP_DOMAIN.
{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy web:80
}

www.{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}

# Database administration (pgAdmin). Started on demand, see docs/operations/deployment.md §7.
# Layer 1: HTTP basic auth here. Layer 2: pgAdmin's own login. PostgreSQL is never published.
# While PGADMIN_AUTH_USER / PGADMIN_AUTH_HASH are empty in .env, Caddy still starts and every
# request is answered 401 (checked on the VPS).
db.{$APP_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    basic_auth {
        # nosemgrep: generic.secrets.security.detected-bcrypt-hash.detected-bcrypt-hash
        # (default hash of a random password that was discarded: not a usable secret)
        {$PGADMIN_AUTH_USER} {$PGADMIN_AUTH_HASH}
    }
    reverse_proxy pgadmin:8080
}
