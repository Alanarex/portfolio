# HTTPS is obtained and renewed automatically from Let's Encrypt for APP_DOMAIN.
{
    email {$ACME_EMAIL}

    # Délais serveur contre les connexions lentes (Slowloris) : en-têtes et corps doivent arriver vite.
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            write 90s
            idle 2m
        }
    }
}

{$APP_DOMAIN} {
    # Le modèle 3D (.glb, déjà en Meshopt) gagne encore ~30 % en zstd/gzip : on l'ajoute aux types compressés
    # (le défaut de Caddy ne couvre ni model/gltf-binary ni application/octet-stream).
    encode zstd gzip {
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type application/xml*
            header Content-Type application/manifest+json*
            header Content-Type application/wasm*
            header Content-Type image/svg+xml*
            header Content-Type font/*
            header Content-Type model/gltf-binary
        }
    }
    # Taille maximale d'une requête (le téléversement le plus lourd du CMS reste sous 16 Mo, Nginx coupe aussi à 16 Mo).
    request_body {
        max_size 20MB
    }
    # La CSP et les autres en-têtes applicatifs sont émis par Laravel (nonce par requête) ; ici, le socle commun,
    # appliqué aussi aux erreurs 502/503 générées par Caddy. `header` remplace la valeur de l'amont : pas de doublon.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy web:80 {
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }
}

www.{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}

# Database administration (Adminer). Started on demand, see docs/operations/deployment.md §7.
# Layer 1: HTTP basic auth here. Layer 2: the PostgreSQL login of Adminer. PostgreSQL is never published.
# While PGADMIN_AUTH_USER and PGADMIN_AUTH_HASH are both empty in .env, Caddy still starts and every
# request is answered 401 (checked on the VPS). Setting only one of them makes Caddy refuse to
# start, which takes the whole site down: set both, then run `caddy validate` (see the guide).
db.{$APP_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    basic_auth {
        {$PGADMIN_AUTH_USER} {$PGADMIN_AUTH_HASH}
    }
    reverse_proxy adminer:8080
}
